Algoritmo "Exercício consumo"

Var
distancia, combustivel, consumo_medio : real
Inicio
      escreva("Distância percorrida: ")
      leia(distancia)
      escreva("Combustível gasto: ")
      leia(combustivel)
      
      consumo_medio <- distancia / combustivel
      escreva("Consumo médio = ", consumo_medio:8:3)
Fimalgoritmo